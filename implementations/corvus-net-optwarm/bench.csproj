<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The JIT, for the evaluator's runtime code generation (native AOT cannot generate code at run time).
         ReadyToRun precompiles the library and the harness, so the process starts on compiled code, and the JIT
         recompiles what is hot with the profile it gathers. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Corvus.Text.Json" Version="*" />
  </ItemGroup>

</Project>
