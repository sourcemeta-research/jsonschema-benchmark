<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native AOT: no JIT, and the package's static profile drives the AOT compiler.
         The instruction set is that of the machine building the image, like Blaze's -march=native. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcInstructionSet>native</IlcInstructionSet>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- The latest stable release: the Dockerfile rebuilds whenever NuGet publishes a new version, and records the one
         restored in /app/corvus-version for version.sh. -->
    <PackageReference Include="Corvus.Text.Json" Version="*" />
  </ItemGroup>

</Project>
